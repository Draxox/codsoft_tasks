# Environment Variables for DineDesk

# PostgreSQL Database Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
# Example for local PostgreSQL (default username is postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dinedesk?schema=public"

# If using Neon / Supabase Cloud PostgreSQL, paste your cloud connection string here:
# DATABASE_URL="postgresql://neondb_owner:xyz@ep-cool-fog-1234.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

